# Скопируйте в .env и заполните.

# Токен бота с платформы MAX для партнёров (business.max.ru → Чат-боты → Расширенные настройки)
MAX_BOT_TOKEN=

# Публичное имя бота (max.ru/<имя>). Можно не указывать — возьмётся из GET /me
BOT_USERNAME=

# --- Получение событий ---
# Пусто — long polling (удобно для разработки, HTTPS не нужен).
# Для прода: https://<домен>/webhook (порт 443, доверенный сертификат)
WEBHOOK_URL=
# Секрет для заголовка X-Max-Bot-Api-Secret (5–256 символов A-Z a-z 0-9 _ -). Пусто — выводится из токена
WEBHOOK_SECRET=

# Домен для HTTPS-прокси Caddy (docker compose --profile https)
DOMAIN=

# Кнопки «Открыть приложение». Пусто — включены, если задан WEBHOOK_URL или PUBLIC_URL.
# Включайте, только когда ссылка на мини-приложение указана в настройках бота на платформе MAX.
# MINIAPP_ENABLED=true

# --- Хранилища (в docker compose задаются автоматически) ---
# DATABASE_URL=postgresql+asyncpg://peremena:peremena@localhost:5432/peremena
# REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=peremena

# --- Прочее ---
DEFAULT_TZ=Europe/Moscow
LOG_LEVEL=INFO
# Вход в мини-приложение из обычного браузера по ?dev_user=<id>. Только для разработки!
DEV_AUTH=false
