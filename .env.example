# Скопируйте в .env и заполните.

# Токен бота с платформы MAX для партнёров (business.max.ru → Чат-боты → Расширенные настройки)
MAX_BOT_TOKEN=

# Публичное имя бота (max.ru/<имя>). Можно не указывать — возьмётся из GET /me
BOT_USERNAME=

# --- Получение событий ---
# Пусто — long polling (удобно для разработки, HTTPS не нужен).
# Для прода: https://<домен>/webhook (порт 443, доверенный сертификат)
WEBHOOK_URL=
# Секрет для заголовка X-Max-Bot-Api-Secret (5–256 символов A-Z a-z 0-9 _ -). Пусто — выводится из токена
WEBHOOK_SECRET=

# Домен для HTTPS-прокси Caddy (docker compose --profile https)
DOMAIN=

# Кнопки «Открыть приложение». Пусто — включены, если задан WEBHOOK_URL или PUBLIC_URL.
# Включайте, только когда ссылка на мини-приложение указана в настройках бота на платформе MAX.
# MINIAPP_ENABLED=true

# --- Хранилища (в docker compose задаются автоматически) ---
# DATABASE_URL=postgresql+asyncpg://peremena:peremena@localhost:5432/peremena
# REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=peremena

# --- Прокси ---
# Порт сервиса на хосте. В docker compose он слушает только 127.0.0.1 — наружу сервис выходит через
# HTTPS-прокси (Caddy из профиля https или свой nginx на этой же машине).
# BOT_PORT=8080
# Чьим заголовкам X-Forwarded-For верить: адреса и сети через запятую. По умолчанию — локальный
# прокси и сети Docker. Не ставьте «*»: тогда любой подделает свой IP и обойдёт лимиты.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.16.0.0/12

# --- Секреты ---
# Ключ подписей сервиса (ссылки на выгрузку CSV). Пусто — выводится из MAX_BOT_TOKEN, а без токена
# генерируется заново при каждом запуске (старые ссылки перестанут работать). Без токена бота вебхук
# отвечает 503 и вход на сайт через бота выключен; работает демо и мини-приложение по DEV_AUTH.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Прочее ---
DEFAULT_TZ=Europe/Moscow
LOG_LEVEL=INFO
# Вход в мини-приложение из обычного браузера по ?dev_user=<id>. Только для разработки!
# При заданном PUBLIC_URL или WEBHOOK_URL игнорируется (с ошибкой в логе): в проде это вход под любым.
DEV_AUTH=false
