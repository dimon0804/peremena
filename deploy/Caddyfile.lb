# Внутренний балансировщик: 127.0.0.1:${BOT_PORT} на хосте → все экземпляры сервиса bot.
# Адреса экземпляров берутся из DNS Docker (имя сервиса bot) и обновляются раз в 5 секунд —
# docker compose up --scale bot=N подхватывается без перезапуска балансировщика.
{
	admin off
	# заголовкам X-Forwarded-* верим только от прокси на этой машине и из сетей Docker
	# (хостовый nginx, Caddy из профиля https) — тогда бот видит настоящий IP родителя
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	reverse_proxy {
		dynamic a {
			name bot
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		# экземпляр перезапускается или упал — запрос уходит в соседний
		lb_try_duration 5s
		fail_duration 10s
		# вебхук MAX ждёт ответ недолго; обработка всё равно идёт в фоне или в очереди
		transport http {
			dial_timeout 2s
		}
	}
}
