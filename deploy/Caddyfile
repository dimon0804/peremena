# HTTPS с автоматическим сертификатом Let's Encrypt.
# MAX принимает вебхуки только по HTTPS на порту 443 с сертификатом доверенного центра.
# Запросы уходят во все экземпляры bot (docker compose up --scale bot=N): адреса — из DNS Docker.
{$DOMAIN} {
	encode gzip
	reverse_proxy {
		dynamic a {
			name bot
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 10s
	}
}
